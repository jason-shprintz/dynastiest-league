# Cloudflare Worker URL for trade analysis API
# Replace with your actual worker URL after deployment
VITE_WORKER_URL=https://dynastiest-league-worker.your-subdomain.workers.dev

# Set to 1 to show the analytics consent banner and gate GA4 behind it.
# Any other value, including unset, means no banner and no gating.
#
# Vite inlines import.meta.env.* at BUILD time, so this must be set wherever
# the build actually runs, and a redeploy is required for a change to take
# effect. There is no Pages build workflow in .github/workflows, so Cloudflare
# builds this site directly from Git: set it in the Pages dashboard under
# Settings > Environment variables > Production. If a GitHub Actions workflow
# ever takes over the build, it must move to an env: block on the build step,
# because a dashboard variable is invisible to a build on GitHub's runners.
#
# Only set this to 1 once the banner is deployed. With the flag on and no
# banner, absent consent counts as a refusal and nothing is tracked at all.
VITE_ANALYTICS_REQUIRE_CONSENT=1
